---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';
---

<section
  id="experiencia"
  aria-labelledby="experiencia-title"
  class="mx-auto w-full max-w-5xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24"
>
  <span id="experiencia-title" class="sr-only">Experiencia</span>
  <SectionHeading eyebrow="03 · Experiencia" title="Trayectoria" />
  <ol class="relative space-y-0 border-l border-border">
    {
      experience.map((item) => (
        <li class="relative pb-10 pl-8 last:pb-0">
          <span
            aria-hidden="true"
            class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent"
          />
          <p class="font-mono text-xs uppercase tracking-widest text-muted">{item.period}</p>
          <h3 class="mt-1 font-semibold">
            {item.role} <span class="font-normal text-muted">· {item.org}</span>
          </h3>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{item.description}</p>
          {item.tags && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {item.tags.map((t) => (
                <li class="rounded-full border border-border px-3 py-0.5 font-mono text-xs text-muted">
                  {t}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</section>
