---
import SectionHeading from './SectionHeading.astro';
import { stack } from '../data/experience';
---

<section id="stack" aria-labelledby="stack-title" class="border-t border-border bg-surface/40">
  <div class="mx-auto w-full max-w-5xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24">
    <span id="stack-title" class="sr-only">Stack tecnológico</span>
    <SectionHeading eyebrow="04 · Stack" title="Herramientas que domino" />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        stack.map((cat) => (
          <div class="rounded-2xl border border-border bg-surface p-6">
            <h3 class="font-mono text-xs font-medium uppercase tracking-widest text-muted">
              {cat.title}
            </h3>
            <ul class="mt-4 space-y-2.5 text-sm font-medium">
              {cat.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span aria-hidden="true" class="text-muted">
                    ▸
                  </span>{' '}
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
