---
import { nav } from '../data/experience';
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8"
  >
    <a href="#inicio" class="font-mono text-sm font-semibold tracking-tight hover:text-muted">
      <span aria-hidden="true" class="text-muted">~/</span>{
        profile.name.toLowerCase().replace(/\s+/g, '-')
      }
    </a>
    <ul class="hidden items-center gap-7 text-sm md:flex">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="text-muted hover:text-text">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:opacity-85 sm:inline-block"
      >
        Contactar
      </a>
      <ThemeToggle />
    </div>
  </nav>
  <!-- Navegación móvil: simple, sin JS -->
  <nav aria-label="Navegación móvil" class="border-t border-border md:hidden">
    <ul class="mx-auto flex w-full max-w-5xl gap-5 overflow-x-auto px-5 py-2.5 text-sm text-muted">
      {
        nav.map((item) => (
          <li class="shrink-0">
            <a href={item.href} class="hover:text-text">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
