---
/* Lightbox minimalista: overlay a pantalla completa, zoom sutil al cambiar,
   navegación 1 a 1 con botones, teclado (←/→/Esc) y click en el fondo.
   Se alimenta de botones `[data-lightbox-open]` con `data-images` (JSON) y `data-title`. */
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm sm:p-10"
  role="dialog"
  aria-modal="true"
  aria-label="Galería de imágenes del proyecto"
>
  <button
    id="lb-close"
    type="button"
    aria-label="Cerrar galería"
    class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white/80 hover:text-white"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>

  <button
    id="lb-prev"
    type="button"
    aria-label="Imagen anterior"
    class="absolute left-2 top-1/2 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 text-white/80 hover:text-white sm:left-6"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <figure class="max-h-full w-full max-w-4xl">
    <img id="lb-img" src="" alt="" class="lb-img max-h-[75vh] w-full rounded-xl object-contain" />
    <figcaption class="mt-3 flex items-center justify-between font-mono text-xs text-white/70">
      <span id="lb-title"></span>
      <span id="lb-counter" aria-live="polite"></span>
    </figcaption>
  </figure>

  <button
    id="lb-next"
    type="button"
    aria-label="Imagen siguiente"
    class="absolute right-2 top-1/2 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 text-white/80 hover:text-white sm:right-6"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>
</div>

<style>
  .lb-img {
    animation: lb-in 0.28s ease;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-img {
      animation: none;
    }
  }
</style>

<script is:inline>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbTitle = document.getElementById('lb-title');
  const lbCounter = document.getElementById('lb-counter');
  let lbImages = [];
  let lbIndex = 0;
  let lbReturnFocus = null;

  function lbShow(i) {
    if (!lbImg || lbImages.length === 0) return;
    lbIndex = (i + lbImages.length) % lbImages.length;
    const src = lbImages[lbIndex];
    // Re-dispara el zoom sutil en cada cambio
    lbImg.classList.remove('lb-img');
    void lbImg.offsetWidth;
    lbImg.setAttribute('src', src);
    lbImg.classList.add('lb-img');
    if (lbCounter) lbCounter.textContent = `${lbIndex + 1} / ${lbImages.length}`;
  }

  function lbOpen(images, title, opener) {
    if (!lb) return;
    lbImages = images;
    lbReturnFocus = opener ?? null;
    if (lbTitle) lbTitle.textContent = title ?? '';
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
    lbShow(0);
    document.getElementById('lb-close')?.focus();
  }

  function lbClose() {
    if (!lb) return;
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
    lbImages = [];
    if (lbReturnFocus instanceof HTMLElement) lbReturnFocus.focus();
  }

  document.querySelectorAll('[data-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const images = JSON.parse(btn.getAttribute('data-images') ?? '[]');
        if (images.length === 0) return;
        lbOpen(images, btn.getAttribute('data-title') ?? '', btn);
      } catch {}
    });
  });

  document.getElementById('lb-close')?.addEventListener('click', lbClose);
  document.getElementById('lb-prev')?.addEventListener('click', (e) => {
    e.stopPropagation();
    lbShow(lbIndex - 1);
  });
  document.getElementById('lb-next')?.addEventListener('click', (e) => {
    e.stopPropagation();
    lbShow(lbIndex + 1);
  });
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) lbClose();
  });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') lbClose();
    if (e.key === 'ArrowLeft') lbShow(lbIndex - 1);
    if (e.key === 'ArrowRight') lbShow(lbIndex + 1);
  });
</script>
