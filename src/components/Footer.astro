---
import { socials } from '../data/experience';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-5 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>© {year} {site.author} · Hecho con Astro, sin trackers.</p>
    <ul class="flex gap-5">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-text">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
