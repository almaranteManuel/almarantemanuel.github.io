---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-2xl">
  <p class="mb-3 font-mono text-xs font-medium uppercase tracking-widest text-muted">
    <span aria-hidden="true" class="mr-2 text-accent">—</span>{eyebrow}
  </p>
  <h2 class="text-balance text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-pretty leading-relaxed text-muted">{description}</p>}
</div>
